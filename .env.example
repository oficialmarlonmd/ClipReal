# Copie este arquivo para ".env" e preencha suas variáveis de ambiente.

# Chave da API Gemini (gratuita em https://aistudio.google.com/apikey)
# Alternativa aceita pelo config.py: GOOGLE_API_KEY
GEMINI_API_KEY=

# Caminho do arquivo OAuth Client (tipo "App para computador") do Google Cloud Console
YOUTUBE_CLIENT_SECRET=credentials/client_secret.json

# Pasta de dados (vídeos, cortes e banco SQLite). Por padrão usa "./data".
# Se o projeto estiver em uma pasta sincronizada na nuvem (OneDrive/iCloud), defina um caminho fora dela:
# macOS/Linux: CLIPSREAL_DATA=/Users/seu_usuario/ClipsRealData
# Windows:     CLIPSREAL_DATA=C:\ClipsRealData
# CLIPSREAL_DATA=

# Porta do painel web
CLIPSREAL_PORT=8000

# Cookies opcionais para baixar vídeos +18 / com verificação de login no YouTube (yt-dlp)
# YT_DLP_COOKIES=credentials/youtube_cookies.txt
# YT_DLP_COOKIES_FROM_BROWSER=safari
