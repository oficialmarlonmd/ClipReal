# Copie este arquivo para ".env" e preencha.
# Chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Caminho do OAuth Client (tipo "App para computador") baixado do Google Cloud Console
YOUTUBE_CLIENT_SECRET=credentials/client_secret.json

# Pasta dos vídeos/cortes. O projeto está no OneDrive: use uma pasta FORA dele p/ não lotar a nuvem.
CLIPSREAL_DATA=C:\ClipsRealData

# Porta do painel web
CLIPSREAL_PORT=8000
